# Database Configuration
DATABASE_URL=postgresql://postgres@localhost:5432/kartmitra

# Model Configurations
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Visual Recognition Settings (DINOv2 + FAISS)
ENABLE_VISUAL_MATCHING=true
VISUAL_INDEX_DIR=data/visual_index
VISUAL_EMBEDDING_MODEL=facebook/dinov2-small
VISUAL_TOP_K=5
VISUAL_MATCH_THRESHOLD=0.82
VISUAL_REVIEW_THRESHOLD=0.70
VISUAL_DEVICE=cpu

# Weight Tolerance
WEIGHT_TOLERANCE_KG=0.05
